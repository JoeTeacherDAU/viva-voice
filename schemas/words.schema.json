{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viva.weevillabs.dev/schemas/words.schema.json",
  "title": "Viva Voice word record list",
  "type": "array",
  "items": { "$ref": "#/$defs/word" },
  "$defs": {
    "word": {
      "type": "object",
      "required": [
        "word",
        "punctuatedWord",
        "startMs",
        "endMs",
        "confidence",
        "channel",
        "isFinal",
        "pass",
        "removedAsCrosstalk",
        "speakerLabel"
      ],
      "additionalProperties": false,
      "properties": {
        "word": { "type": "string" },
        "punctuatedWord": { "type": "string" },
        "startMs": { "type": "number", "minimum": 0 },
        "endMs": { "type": "number", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "channel": { "enum": [0, 1] },
        "isFinal": { "type": "boolean" },
        "pass": { "enum": [1, 2] },
        "removedAsCrosstalk": { "type": "boolean" },
        "inWindow": { "type": "boolean" },
        "isFiller": { "type": "boolean" },
        "isRepetition": { "type": "boolean" },
        "isBackchannel": { "type": "boolean" },
        "inGap": { "type": "boolean" },
        "overlapsPartner": { "type": "boolean" },
        "partnerSilenceMs": { "type": ["number", "null"] },
        "partnerResumesNext": { "type": "boolean" },
        "floorClass": { "enum": ["backchannel", "turn"] },
        "speakerLabel": { "enum": ["A", "B"] }
      }
    }
  }
}
