{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viva.weevillabs.dev/schemas/session.schema.json",
  "title": "Viva Voice session record",
  "type": "object",
  "required": [
    "id",
    "examId",
    "participantIds",
    "config",
    "markers",
    "events",
    "instructorLiveScore",
    "passes",
    "pipelineVersion",
    "deepgramModel",
    "firmware",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$" },
    "examId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$" },
    "state": { "enum": ["setup", "live", "closing", "done"] },
    "participantIds": {
      "type": "object",
      "required": ["A", "B"],
      "additionalProperties": false,
      "properties": {
        "A": { "type": "string", "minLength": 1 },
        "B": { "type": "string", "minLength": 1 }
      }
    },
    "channelMap": {
      "description": "Which capture channel carries which student. Set on the setup screen.",
      "type": "object",
      "required": ["0", "1"],
      "additionalProperties": false,
      "properties": {
        "0": { "enum": ["A", "B"] },
        "1": { "enum": ["A", "B"] }
      }
    },
    "config": { "$ref": "#/$defs/config" },
    "markers": {
      "type": "object",
      "required": ["startMs", "stopMs"],
      "additionalProperties": false,
      "properties": {
        "startMs": { "type": ["number", "null"], "minimum": 0 },
        "stopMs": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "atMs"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "atMs": { "type": "number" },
          "detail": {}
        }
      }
    },
    "instructorLiveScore": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["value", "atMs"],
          "additionalProperties": false,
          "properties": {
            "value": { "type": "integer", "minimum": 1, "maximum": 5 },
            "atMs": { "type": "number", "minimum": 0 }
          }
        }
      ]
    },
    "passes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "1": { "$ref": "#/$defs/passRef" },
        "2": { "$ref": "#/$defs/passRef" }
      }
    },
    "pipelineVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "deepgramModel": { "type": "string" },
    "firmware": {
      "type": "object",
      "required": ["tx", "rx"],
      "additionalProperties": false,
      "properties": {
        "tx": { "type": "string" },
        "rx": { "type": "string" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "captureMode": {
      "description": "live: recorded on the session screen. file-import: cut from a session file on /import/session. Absent means live.",
      "enum": ["live", "file-import"]
    },
    "source": {
      "description": "File-import pairs only: where the pair's audio came from.",
      "oneOf": [
        {
          "description": "Session-file pairs (work order 02): the session file and this pair's frame offsets in it. endFrame is exclusive.",
          "type": "object",
          "required": [
            "sessionLabel",
            "sessionDate",
            "order",
            "rawPath",
            "rawSha256",
            "sliceSha256",
            "startFrame",
            "endFrame",
            "sampleRate",
            "bitsPerSample",
            "encoding"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": { "const": "session-file" },
            "sessionLabel": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
            "sessionDate": { "type": "string", "format": "date" },
            "order": { "type": "integer", "minimum": 1 },
            "rawPath": { "type": "string" },
            "rawSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "sliceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "startFrame": { "type": "integer", "minimum": 0 },
            "endFrame": { "type": "integer", "minimum": 1 },
            "sampleRate": { "type": "integer", "minimum": 1 },
            "bitsPerSample": { "enum": [16, 24, 32] },
            "encoding": { "enum": ["pcm16", "pcm24", "float32"] }
          }
        },
        {
          "description": "Pair-file pairs (work order 03): the pair's own WAV, stored byte for byte. session holds the pair's frames in the session-wide WAV and appears only when the pair durations summed to its length within 50 ms.",
          "type": "object",
          "required": [
            "mode",
            "sessionLabel",
            "sessionDate",
            "order",
            "fileName",
            "track",
            "fileSha256",
            "fileBytes",
            "frames",
            "sampleRate",
            "bitsPerSample",
            "encoding"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": { "const": "pair-file" },
            "sessionLabel": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
            "sessionDate": { "type": "string", "format": "date" },
            "order": { "type": "integer", "minimum": 1 },
            "fileName": { "type": "string", "minLength": 1 },
            "track": { "type": "string" },
            "fileSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "fileBytes": { "type": "integer", "minimum": 1 },
            "frames": { "type": "integer", "minimum": 1 },
            "sampleRate": { "type": "integer", "minimum": 1 },
            "bitsPerSample": { "enum": [16, 24] },
            "encoding": { "enum": ["pcm16", "pcm24"] },
            "session": {
              "type": "object",
              "required": ["rawPath", "rawSha256", "startFrame", "endFrame"],
              "additionalProperties": false,
              "properties": {
                "rawPath": { "type": "string" },
                "rawSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "startFrame": { "type": "integer", "minimum": 0 },
                "endFrame": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      ]
    },
    "excluded": {
      "description": "The archive keeps this pair's audio, and pass two, documents, and CSV rows skip it.",
      "type": "object",
      "required": ["reason", "consent"],
      "additionalProperties": false,
      "properties": {
        "reason": { "enum": ["consent"] },
        "consent": {
          "type": "object",
          "additionalProperties": { "enum": ["granted", "declined", "pending", "unknown"] }
        }
      }
    }
  },
  "$defs": {
    "passRef": {
      "type": "object",
      "required": ["transcript", "measurements"],
      "additionalProperties": false,
      "properties": {
        "transcript": { "type": "string" },
        "measurements": { "type": "string" },
        "completedAt": { "type": "string", "format": "date-time" },
        "source": { "enum": ["usb", "onboard", "file"] }
      }
    },
    "config": {
      "type": "object",
      "required": [
        "gainDb",
        "pauseThresholdsMs",
        "turnThresholdMs",
        "gatingMarginDb",
        "compositeWeights",
        "weightsVersion",
        "baselineMinSessions",
        "fillerTokens",
        "backchannelTokens",
        "targetPatterns",
        "keyterms",
        "durationMs"
      ],
      "additionalProperties": false,
      "properties": {
        "gainDb": { "type": "number", "minimum": -12, "maximum": 12 },
        "pauseThresholdsMs": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 1
        },
        "turnThresholdMs": { "type": "integer", "minimum": 1 },
        "floorLapseMs": {
          "description": "A partner silence at or above this leaves the floor open, so a backchannel-token run there counts as a one-word turn. Default 1500.",
          "type": "integer",
          "minimum": 1
        },
        "gatingMarginDb": { "type": "number", "minimum": 0 },
        "speechFloorDbfs": {
          "description": "A frame counts as speech when either channel reaches this level. Default -60.",
          "type": "number",
          "maximum": 0
        },
        "compositeWeights": {
          "type": "object",
          "required": ["silent_pause_rate", "speech_rate_wpm", "mean_length_of_run"],
          "additionalProperties": false,
          "properties": {
            "silent_pause_rate": { "type": "number", "minimum": 0 },
            "speech_rate_wpm": { "type": "number", "minimum": 0 },
            "mean_length_of_run": { "type": "number", "minimum": 0 }
          }
        },
        "weightsVersion": { "type": "string" },
        "baselineMinSessions": { "type": "integer", "minimum": 1 },
        "fillerTokens": { "type": "array", "items": { "type": "string" } },
        "backchannelTokens": { "type": "array", "items": { "type": "string" } },
        "targetPatterns": { "type": "array", "items": { "type": "string" } },
        "keyterms": { "type": "array", "items": { "type": "string" } },
        "durationMs": { "type": "integer", "minimum": 1000 }
      }
    }
  }
}
