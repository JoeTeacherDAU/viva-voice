{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viva.weevillabs.dev/schemas/roster.schema.json",
  "title": "Viva Voice roster (roster/{examId}.json)",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "participantId", "consentStatus"],
    "additionalProperties": false,
    "properties": {
      "name": { "type": "string", "minLength": 1 },
      "participantId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
      "consentStatus": { "enum": ["granted", "declined", "pending"] }
    }
  }
}
