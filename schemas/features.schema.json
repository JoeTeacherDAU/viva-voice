{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viva.weevillabs.dev/schemas/features.schema.json",
  "title": "Viva Voice feature registry",
  "type": "object",
  "required": [
    "registryVersion",
    "generated",
    "tiers",
    "inputs",
    "features"
  ],
  "properties": {
    "registryVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated": {
      "type": "string",
      "format": "date"
    },
    "tiers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tier",
          "construct",
          "unit",
          "inputs",
          "formula",
          "params",
          "reference",
          "caveats"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "construct": {
            "type": "string",
            "enum": [
              "speed",
              "breakdown",
              "repair",
              "interaction",
              "lexical",
              "composite",
              "quality",
              "syntax",
              "morphology",
              "pragmatics",
              "code-switching",
              "rhythm",
              "prosody",
              "segmental",
              "voice",
              "nonverbal",
              "perceived"
            ]
          },
          "unit": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "words",
                "energy",
                "audio",
                "alignment",
                "roster",
                "instructor",
                "rawAsr",
                "verbatim",
                "phones"
              ]
            }
          },
          "formula": {
            "type": "string"
          },
          "params": {
            "type": "object"
          },
          "reference": {
            "type": "string"
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}